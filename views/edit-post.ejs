<html lang="en">
    <%- include('includes/head') %>
    <body>
        <%- include('includes/header') %>
        <main>
            <form action="/edit-post/<%= post.id %>" method="POST">

                <% errors.forEach(error => { %>
                    <p class="notice"><%= error %></p>
                <% }); %>   
                <h5>Edit this existing Post</h5>
                <fieldset>
                    <legend>Edit this Post</legend>
                    <label for="title"><small>Title<span title="Description can be 50 characters long.">&#9432;</span></small></label>
                    <input type="text" value="<%= post.title %>" id="title" name="title" autocomplete="off" />
                                        
                    <label for="body"><small>Content</small></label>
                    <textarea name="body" id="body"><%= post.body %></textarea>
                    
                    <br />
                    <br />
                    <button>Save Changes</button>
                    
                </fieldset>
            </form> 
        </main> 
        <%- include('includes/footer') %>
    </body>
</html>