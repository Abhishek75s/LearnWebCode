<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <h2><a href="/">Our wonderful App</a></h2>
        <nav>
            <a href="/login">Log In</a>
        </nav>
    </header>

    <main>
        <form action="/register" method="POST">

            <% errors.forEach(error => { %>
                <p class="notice"><%= error %></p>
            <% }); %>
            
            
            <fieldset>
                <legend>Create an account</legend>
                <label for="username"><small>Enter Username <span title="Username must be between 3 and 18 characters.">&#9432;</span></small></label>
                <input type="text" placeholder="username" ="username" name="username" autocomplete="off">
                
                <label for="password"><small>Enter Password <span title="Password must be only alphanumeric and 4 to 20 chars long">&#x24D8;</span></small></label>
                <input type="password" id="password" placeholder="password" name="password" autocomplete="off">

                <br />
                <button>Sign Up</button>
                
            </fieldset>
        </form> 
    </main>

    <footer>
        <small><span title="Copyright">&copy;2026</span> Our wonderful App</small>
    </footer>
</body>
</html>