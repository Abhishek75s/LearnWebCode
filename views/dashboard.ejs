<html lang="en">

<%- include('includes/head') %>

<body>
    <%- include('includes/header') %>

    <main>
        <div>
            <H1>Welcome to your Dashboard</H1>

            <ul>
                <% posts.forEach(post => { %>
                    <h4><li><a href="/post/<%= post.id%>"><%= post.title %> on <small><%= new Date(post.createdDate).getDate() %> <%= new Date(post.createdDate).toLocaleString('en-US', { month: 'short' })%>, <%= new Date(post.createdDate).getFullYear() %> </small></a> </li></h4>
                <% }) %>
            </ul>
            
        </div>
    </main>

    <%- include('includes/footer') %>

</body>
</html>